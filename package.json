{
  "name": "extensionx",
  "version": "6.1.7",
  "description": "Extension Chrome mạnh mẽ cho phép bạn tải toàn bộ ảnh, video và GIF từ bất kỳ profile nào trên X.com (Twitter) với chất lượng gốc, hoàn toàn tự động và sắp xếp gọn gàng vào thư mục theo tên người dùng.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/shared test",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/fixture-regression.test.ts",
    "test:browser": "npm run build && node --test test/e2e/chrome-extension.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazz2607/extensionX.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kazz2607/extensionX/issues"
  },
  "homepage": "https://github.com/kazz2607/extensionX#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.42",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vite-plugin-web-extension": "^4.5.1"
  }
}
