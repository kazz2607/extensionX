{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "5.5.2",

  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Media Downloader"
  },
  "background": {
    "service_worker": "background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/content.ts"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/shortcuts.ts"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "declarativeNetRequest",
    "offscreen",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://cdn.syndication.twimg.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-interceptor.js",
        "content/dom-scanner.js",
        "content/fab.js",
        "content/tweet-btn.js",
        "content/snackbar.js",
        "lib/utils.js",
        "lib/hls-fetcher.js",
        "lib/i18n.js"
      ],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_page": "options/options.html"
}
