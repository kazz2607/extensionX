{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "8.1.0",

  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Media Downloader"
  },
  "background": {
    "service_worker": "background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "content/main-world.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/content.ts"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://*.x.com/*", "https://*.twitter.com/*"],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://sheets.google.com/*",
        "https://slides.google.com/*",
        "https://notion.so/*",
        "https://*.notion.so/*",
        "https://www.notion.so/*"
      ],
      "js": ["content/shortcuts.ts"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content/tg-content.ts"],
      "css": ["content/tg-styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content/tg-main.ts"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "offscreen",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://web.telegram.org/*"
  ],
  "options_page": "options/options.html",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
